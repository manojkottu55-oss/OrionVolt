# ── OrionVolt Backend — Required Environment Variables ──
# Copy this file to .env and fill in your values.

# Server
PORT=5000

# Supabase (service role key — server-side only, NEVER expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MQTT Broker (EMQX Cloud — format: mqtts://user:pass@host:8883)
MQTT_BROKER_URL=

# Google OAuth (configured in Supabase Auth dashboard)
GOOGLE_CLIENT_ID=
